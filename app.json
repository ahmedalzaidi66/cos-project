{
  "expo": {
    "name": "Lazurde Beauty",
    "slug": "lazurde-beauty",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lazurde",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lazurde.beauty"
    },
    "android": {
      "package": "com.lazurde.beauty"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Lazurde Beauty",
      "shortName": "Lazurde",
      "description": "Premium makeup loved by beauty enthusiasts worldwide",
      "themeColor": "#FF4D8D",
      "backgroundColor": "#FFFFFF"
    },
    "plugins": ["expo-router", "expo-font", "expo-web-browser"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
